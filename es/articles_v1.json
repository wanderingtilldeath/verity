{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "max_terms_count": 65536,
    "analysis": {
      "filter": {
        "english_possessive": { "type": "stemmer", "language": "possessive_english" },
        "english_stemmer": { "type": "stemmer", "language": "light_english" },
        "english_stop": { "type": "stop", "stopwords": "_english_" },
        "ascii_keep_original": { "type": "asciifolding", "preserve_original": true }
      },
      "analyzer": {
        "wiki_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "english_possessive",
            "lowercase",
            "english_stop",
            "ascii_keep_original",
            "english_stemmer"
          ]
        }
      },
      "normalizer": {
        "lowercase_norm": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "_meta": { "winnow_k": 5, "winnow_w": 4, "hash_bits": 64 },
    "_source": { "excludes": ["fingerprints"] },
    "properties": {
      "page_id": { "type": "long" },
      "title": {
        "type": "text",
        "analyzer": "wiki_text",
        "fields": {
          "exact": { "type": "keyword", "normalizer": "lowercase_norm" },
          "suggest": { "type": "search_as_you_type", "max_shingle_size": 3 }
        }
      },
      "text": {
        "type": "text",
        "analyzer": "wiki_text",
        "index_options": "offsets"
      },
      "url": { "type": "keyword", "index": false, "doc_values": false },
      "fingerprints": { "type": "keyword", "norms": false, "doc_values": false }
    }
  }
}
