{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "analysis": {
      "filter": {
        "english_possessive": { "type": "stemmer", "language": "possessive_english" },
        "english_stemmer": { "type": "stemmer", "language": "light_english" },
        "english_stop": { "type": "stop", "stopwords": "_english_" },
        "ascii_keep_original": { "type": "asciifolding", "preserve_original": true }
      },
      "analyzer": {
        "wiki_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "english_possessive",
            "lowercase",
            "english_stop",
            "ascii_keep_original",
            "english_stemmer"
          ]
        }
      },
      "normalizer": {
        "lowercase_norm": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "page_id": { "type": "long" },
      "title": {
        "type": "text",
        "analyzer": "wiki_text",
        "fields": {
          "exact": { "type": "keyword", "normalizer": "lowercase_norm" },
          "std": { "type": "text", "analyzer": "standard" },
          "english": { "type": "text", "analyzer": "english" }
        }
      },
      "text": {
        "type": "text",
        "analyzer": "wiki_text",
        "fields": {
          "std": { "type": "text", "analyzer": "standard" },
          "english": { "type": "text", "analyzer": "english" }
        }
      },
      "url": { "type": "keyword", "index": false, "doc_values": false }
    }
  }
}
